            <parameter key="also_apply_to_special_attributes_(id,_label..)" value="false"/>
          </operator>
          <operator activated="true" class="blending:generate_columns" compatibility="12.1.001" expanded="true" height="82" name="Generate Attributes (2)" width="90" x="246" y="34">
            <list key="function_descriptions">
              <parameter key="Age" value="if(Age &lt; 0 || Age &gt; 100,MISSING_NUMERIC , Age)"/>
              <parameter key="Num_Bank_Accounts" value="if(Num_Bank_Accounts &lt; 0 || Num_Bank_Accounts &gt; 20, MISSING_NUMERIC, Num_Bank_Accounts)"/>
              <parameter key="Num_Credit_Card" value="if(Num_Credit_Card &lt; 0 || Num_Credit_Card &gt; 20, MISSING_NUMERIC, Num_Credit_Card)"/>
              <parameter key="Interest_Rate" value="if(Interest_Rate &lt; 1 || Interest_Rate &gt; 40, MISSING_NUMERIC, Interest_Rate)"/>
              <parameter key="Num_of_Loan" value="if(Num_of_Loan &lt; 0 || Num_of_Loan &gt; 20, MISSING_NUMERIC, Num_of_Loan)"/>
              <parameter key="Credit_History_Age" value="if(Credit_History_Age == &quot;NA&quot;, MISSING_NUMERIC, parse(replace(Credit_History_Age, &quot; Years&quot;, &quot;&quot;)))"/>
              <parameter key="Annual_Income" value="if(Annual_Income &gt; 300000, 0/0, Annual_Income)"/>
              <parameter key="Monthly_Income" value="Annual_Income/12"/>
              <parameter key="Amount_invested_monthly" value="if(Amount_invested_monthly &gt; 500, MISSING_NUMERIC, Amount_invested_monthly)"/>
              <parameter key="Num_of_Delayed_Payment" value="if(Num_of_Delayed_Payment &gt; 35, MISSING_NUMERIC, Num_of_Delayed_Payment)"/>
            </list>
            <parameter key="keep_all_columns" value="true"/>
            <parameter key="default_time_zone" value="Australia/Sydney"/>
          </operator>
