              <parameter key="Amount_invested_monthly" value="average"/>
              <parameter key="Credit_History_Age" value="average"/>
              <parameter key="Num_Bank_Accounts" value="average"/>
              <parameter key="Num_Credit_Card" value="average"/>
              <parameter key="Num_of_Loan" value="average"/>
              <parameter key="Num_of_Delayed_Payment" value="average"/>
              <parameter key="Credit_Mix" value="value"/>
              <parameter key="Payment_Behaviour" value="value"/>
              <parameter key="Num_of_Delayed_Payment" value="average"/>
              <parameter key="Occupation" value="value"/>
              <parameter key="Annual_Income" value="average"/>
            </list>
            <parameter key="replenishment_value" value="Unknown"/>
          </operator>
          <operator activated="true" class="blending:generate_columns" compatibility="12.1.001" expanded="true" height="82" name="Generate Attributes (3)" width="90" x="514" y="34">
            <list key="function_descriptions">
              <parameter key="Num_Credit_Card" value="round(Num_Credit_Card)"/>
              <parameter key="Num_Bank_Accounts" value="round(Num_Bank_Accounts)"/>
              <parameter key="Num_of_Loan" value="round(Num_of_Loan)"/>
